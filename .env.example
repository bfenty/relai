# Copy to .env and fill in values
RELAI_ADMIN_KEY=your-api-bearer-key
RELAI_ADMIN_USERNAME=admin
RELAI_ADMIN_PASSWORD=change-me
# Production deployments should use PostgreSQL for per-request usage logs.
# docker-compose provides this default; external deployments can point to their own Postgres.
RELAI_LOG_DB_URL=postgres://relai:relai@postgres:5432/relai_logs?sslmode=disable
# Docker Compose defaults this to true. LXC/external deployments should set this true
# after RELAI_LOG_DB_URL points to a reachable PostgreSQL instance.
RELAI_REQUIRE_POSTGRES_LOGS=true
# Set to true when serving behind HTTPS
RELAI_SECURE_COOKIES=false
# Set to true if /ready should require at least one configured active model target.
RELAI_READY_REQUIRE_MODELS=false
